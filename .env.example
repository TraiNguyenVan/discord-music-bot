DISCORD_TOKEN=put-your-bot-token-here
# skip is instant for anyone (no voting); double-taps inside this window are no-ops
SKIP_DEBOUNCE_SEC=1.5
INACTIVITY_TIMEOUT=43200
# bot stays in voice when the channel empties; idle safety net only
ACTIVITY_NAME=
LOG_LEVEL=INFO
YDL_FORCE_IPV4=true
# browser YouTube picker (/music mode:web): port the sidecar listens on.
# Zero-config: the bot opens a free Cloudflare quick tunnel on startup and
# uses its https URL for picker links — no LAN IP / port-forwarding needed.
# Optional overrides:
#   CLOUDFLARE_TUNNEL=false  -> disable tunnel, use WEB_BASE_URL / LAN IP
#   WEB_BASE_URL=https://... -> fixed public URL (custom domain / reverse proxy)
WEB_PORT=8765
WEB_HOST=0.0.0.0
CLOUDFLARE_TUNNEL=true
# WEB_BASE_URL=http://192.168.1.10:8765
# Link lifetime is heartbeat-driven (no fixed 15-min expiry): an open picker
# page keeps the tunnel alive; after WEB_HEARTBEAT_TIMEOUT with no open page
# the tunnel stops in TUNNEL_SHUTDOWN_DELAY and stale sessions are swept
# WEB_SESSION_GRACE seconds after their last heartbeat. The next 🌐 Picker
# tap restarts the tunnel on demand.
WEB_HEARTBEAT_TIMEOUT=90
TUNNEL_SHUTDOWN_DELAY=300
# WEB_SESSION_GRACE=450
